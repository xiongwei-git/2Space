{
  "name": "2space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @2space/web",
    "build": "npm run build -w @2space/web && npm run build -w @2space/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "npm run start -w @2space/server",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"scripts/*.mjs\" \"docs/**/*.md\" \"*.{json,md,yaml}\" \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,json}\" \"scripts/*.mjs\" \"docs/**/*.md\" \"*.{json,md,yaml}\" \".github/workflows/*.yml\"",
    "design:check": "node scripts/check-design.mjs && npm run copy:check",
    "test:visual": "npm run design:check && npm run build && node scripts/visual-acceptance.mjs",
    "test:links": "npm run build -w @2space/server && node scripts/short-links-acceptance.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "test:parity": "npm run build -w @2space/server && node scripts/reference-parity.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^24.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
